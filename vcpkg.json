{
    "name": "zct-slms",
    "version-string": "1.0.0",
    "description": "Multi-platform software licensing server (SQLite default, PostgreSQL/MySQL optional)",
    "features": {
        "postgres": {
            "description": "PostgreSQL backend support via libpq",
            "dependencies": [
                "libpq"
            ]
        },
        "mysql": {
            "description": "MySQL / MariaDB backend support via libmariadb (MariaDB Connector/C, API compatible with libmysqlclient)",
            "dependencies": [
                "libmariadb"
            ]
        }
    },
    "default-features": [],
    "dependencies": [
        "drogon",
        "sqlite3",
        "yaml-cpp",
        "openssl",
        "argon2",
        {
            "name": "curl",
            "default-features": false,
            "features": [
                "ssl",
                "non-http"
            ]
        }
    ]
}




